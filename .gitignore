# 1. Ignore everything by default
*

# 2. Allow the essential website files in the root
!index.html
!style.css
!script.js
!manifest.webmanifest
!.gitignore

# 3. Allow your public assets (folders must be re-included first)
!Materials/
!Materials/Public/
!Materials/Public/**

# 4. Allow only the vite config from Operators/Configury
!Operators/
!Operators/Configury/
Operators/Configury/*
!Operators/Configury/vite.config.js

# 5. Explicitly ignore your private tooling and scratchpads
Operators/Configury/vibe.py
Operators/Configury/planner.txt
Materials/System/guide.txt
Materials/Private/
Materials/System/
Prototypes/
NEW_*